# Trading 212 API key (get from Trading 212 app: Settings -> API)
TRADING212_API_KEY=your_trading212_api_key_here

# Use "live" or "demo" environment
TRADING212_ENV=demo

# Discord webhook URL for notifications
# (Discord Server Settings -> Integrations -> Webhooks -> New Webhook -> Copy URL)
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your/webhook/url

# Agent mode: "auto" (execute trades automatically), "notify" (Discord only), "both"
AGENT_MODE=notify

# Monitoring interval in seconds (default: 60)
MONITOR_INTERVAL=60

# Optional: Musaffa API key for enhanced sharia screening
# (get from https://musaffa.com)
MUSAFFA_API_KEY=

# Comma-separated list of stock tickers to monitor (e.g. AAPL,MSFT,AMZN)
WATCHLIST=AAPL,MSFT,AMZN,GOOGL,TSLA

# Buy signal: trigger when price drops this % below the recent high
BUY_SIGNAL_THRESHOLD=2.0

# Sell signal: trigger when price rises this % above the recent low
SELL_SIGNAL_THRESHOLD=3.0

# Maximum position size as a fraction of available cash (0.0 – 1.0)
MAX_POSITION_SIZE=0.1
